# Template for e2e/playwright/.env, which support/env.ts loads for local runs of the suite and the
# contract check. Copy it to .env (gitignored) and fill in only what you need.
#
# Nothing here is required for the default flow: `make e2e-env-up && make e2e` runs against the
# local Docker stack and the fake Microsoft services, with no secrets. Variables already set in
# the shell take precedence over this file.

# Mattermost server under test. Defaults to the disposable Docker server.
# PW_BASE_URL=http://localhost:8065
# PW_ADMIN_USERNAME=
# PW_ADMIN_PASSWORD=
# PW_ADMIN_EMAIL=

# Required when PW_BASE_URL is not the disposable server, since the default password is public.
# PW_REGULAR_USER_PASSWORD=

# Allows setup to delete other teams on a non-disposable server.
# PW_DELETE_OTHER_TEAMS=false

# Set to false to watch the browser (same as `npm run test:headed`).
# PW_HEADLESS=true

# Control API of the fake Microsoft services.
# FAKE_URL=http://127.0.0.1:8080

# Live Entra tenant, used only by `npm run contract:live` and `npm run contract:compare`.
# Use a dedicated test tenant, never the corporate one. See README.md for setup.
# MSTEAMS_E2E_TENANT_ID=
# MSTEAMS_E2E_CLIENT_ID=
# MSTEAMS_E2E_CLIENT_SECRET=
# MSTEAMS_E2E_USER1_EMAIL=
# MSTEAMS_E2E_USER2_EMAIL=
